{
  "name": "app-flow",
  "version": "1.0.0",
  "main": "server.js",
  "scripts": {
    "start:dev": "tsx --env-file=.env src/server.ts",
    "start:watch": "tsx watch --env-file=.env src/server.ts",
    "dist": "tsup src",
    "start:dist": "npm run dist && --env-file=.env node dist/server.js"
  },
  "keywords": ["api", "rest", "podcast", "nodejs", "typescript"],
  "author": "Luis Felipe Mondini",
  "license": "ISC",
  "description": "API REST de listagem e filtragem de episódios de podcasts, construída com Node.js e TypeScript puro, sem frameworks.",
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
